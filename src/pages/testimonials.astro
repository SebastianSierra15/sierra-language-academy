---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { messages, testimonials, whatsappUrl } from "../data/site";
import { pageSeo } from "../data/seo";
---

<BaseLayout {...pageSeo.testimonials}>
  <PageHero
    eyebrow="Testimonials"
    title="Focused learners, practical outcomes."
    description="Client quotes from the prototype are included as content placeholders and should be confirmed by the client before final production launch."
  />

  <section class="section">
    <div class="container">
      <div class="testimonial-carousel reveal" aria-label="Student testimonials carousel">
        <div class="testimonial-track">
          {[...testimonials, ...testimonials].map((testimonial, index) => (
            <article class="card testimonial-slide" aria-hidden={index >= testimonials.length ? "true" : "false"}>
              <p>"{testimonial.text}"</p>
              <div>
                <h2 style="font-size: 2rem;">{testimonial.name}</h2>
                <p class="meta">{testimonial.language}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container section-head center reveal">
      <p class="eyebrow">Your Story</p>
      <h2>Build confidence in the language that matters to your next opportunity.</h2>
      <a class="btn btn-primary" href={whatsappUrl(messages.consultation)} target="_blank" rel="noreferrer" title="Start with a free consultation on WhatsApp">Start With a Consultation</a>
    </div>
  </section>
</BaseLayout>
