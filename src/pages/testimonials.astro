---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { messages, testimonials, whatsappUrl } from "../data/site";
---

<BaseLayout title="Testimonials | Sierra Language Academy">
  <PageHero
    eyebrow="Testimonials"
    title="Focused learners, practical outcomes."
    description="Client quotes from the prototype are included as content placeholders and should be confirmed by the client before final production launch."
  />

  <section class="section">
    <div class="container grid-3">
      {testimonials.map((testimonial) => (
        <article class="card reveal">
          <p style="font-size: 1.15rem; font-style: italic;">"{testimonial.text}"</p>
          <div style="margin-top: 28px;">
            <h2 style="font-size: 2rem;">{testimonial.name}</h2>
            <p class="meta">{testimonial.language}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section dark">
    <div class="container section-head center reveal">
      <p class="eyebrow">Your Story</p>
      <h2>Build confidence in the language that matters to your next opportunity.</h2>
      <a class="btn btn-primary" href={whatsappUrl(messages.consultation)} target="_blank" rel="noreferrer">Start With a Consultation</a>
    </div>
  </section>
</BaseLayout>
