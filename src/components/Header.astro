---
import { headerLinks, messages, whatsappUrl } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand brand-full" href="/" aria-label="Sierra Language Academy home" title="Sierra Language Academy home">
      <img class="brand-logo-full" src="/assets/sierra-logo-full.svg" alt="Sierra Language Academy logo" title="Sierra Language Academy logo" />
    </a>

    <nav class="nav-links" id="site-menu" aria-label="Primary navigation">
      {headerLinks.map((link) => (
        <a class={currentPath === link.href ? "active" : ""} href={link.href} title={`View ${link.label}`}>
          {link.label}
        </a>
      ))}
    </nav>

    <a class="btn btn-dark nav-cta" href={whatsappUrl(messages.consultation)} target="_blank" rel="noreferrer" title="Book a free consultation on WhatsApp">
      Book Free Consultation
    </a>

    <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false">
      <span class="sr-only">Open menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>
